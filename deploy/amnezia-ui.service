[Unit]
Description=AmneziaWG client console
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/amnezia-ui
ExecStart=/usr/bin/python3 /opt/amnezia-ui/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
