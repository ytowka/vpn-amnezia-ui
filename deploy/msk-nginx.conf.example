# MSK entrypoint. Replace @PROXY_TOKEN@ privately, never commit the rendered file.
server {
    listen 80 ssl;
    server_name 178.236.242.31;
    ssl_certificate /etc/nginx/amnezia/msk-cert.pem;
    ssl_certificate_key /etc/nginx/amnezia/msk-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 4k;
    client_header_timeout 15s;
    client_body_timeout 15s;
    access_log off;
    location / {
        # Numeric IPv6: there is no IPv4 upstream/fallback.
        proxy_pass https://[2a03:6f02::423b]:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Console-Proxy-Token "@PROXY_TOKEN@";
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_trusted_certificate /etc/nginx/amnezia/nl-cert.pem;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream off;
        proxy_buffering off;
    }
}
